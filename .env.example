# Puffora backend configuration.
#
# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.
# Load it with:  node --env-file=.env server.js
# (Node 20.6+ supports --env-file natively; no dotenv package is required.)

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=3000

# --- Razorpay (from Dashboard > Settings > API keys) -------------------------
# RAZORPAY_KEY_ID is public and is sent to the browser to open Razorpay Checkout.
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
# RAZORPAY_KEY_SECRET must NEVER be sent to the browser or committed.
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# --- Razorpay webhook --------------------------------------------------------
# Create under Dashboard > Settings > Webhooks.
# POST URL: https://your-api-domain.com/api/webhooks/razorpay
# Events: payment.captured, order.paid
# Must match the secret configured in the Razorpay dashboard exactly.
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# --- Admin -------------------------------------------------------------------
# Shared secret protecting GET /api/orders. Send as either header:
#   Authorization: Bearer <key>    or    X-Admin-Key: <key>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=GENERATE_A_LONG_RANDOM_STRING

# --- CORS --------------------------------------------------------------------
# Comma-separated list of storefront origins permitted to call the API.
# Must be HTTPS and must NOT include localhost in production.
# Example: https://www.puffora.com,https://puffora.com
ALLOWED_ORIGINS=https://www.yourdomain.com

# Public origin of the storefront, used for logging and HTTPS validation.
STOREFRONT_ORIGIN=https://www.yourdomain.com

# --- Storage -----------------------------------------------------------------
# Location of the SQLite order database. Defaults to ./data/orders.db.
PUFFORA_DB_PATH=./data/orders.db

# --- Frontend (build-time, in js/config.js) ----------------------------------
# Set window.PUFFORA_API_BASE before js/config.js loads, e.g. in the HTML:
#   <script>window.PUFFORA_API_BASE = 'https://api.yourdomain.com';</script>
# Leave unset when the API is same-origin or behind a reverse proxy.
PUFFORA_API_BASE=https://api.yourdomain.com